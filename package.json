{
  "name": "parent-guidance-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design": "node scripts/check-design-rules.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:tokens && pnpm check:design && pnpm check:docs && pnpm test && pnpm build",
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-wp-theme.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check && node scripts/build-wp-theme.mjs --check && node scripts/check-token-export.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "wp:assets": "node scripts/export-wp-assets.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "clsx": "2.1.1",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.29.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.29.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "jsdom": "^30.1.2",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.13",
    "storybook": "^10.6.1",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vite": "6.3.5",
    "vitest": "^3.2.7"
  },
  "description": "Interactive prototype of Parent Guidance (parentguidance.org) built on the PG design system.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
